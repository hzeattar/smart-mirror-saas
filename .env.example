APP_NAME="Smart Mirror SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=smart_mirror
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

BROADCAST_CONNECTION=log
# BROADCAST_CONNECTION=reverb
REVERB_APP_ID=smart-mirror
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

BACKGROUND_REMOVAL_URL=
BACKGROUND_REMOVAL_TOKEN=
PYTHON_BINARY=python3
CHECKOUT_TTL_MINUTES=20

KIOSK_AUTO_START_DELAY_SECONDS=1.0
KIOSK_COUNTDOWN_SECONDS=0.9
KIOSK_AI_TRYON_ENABLED=true
KIOSK_PRIVACY_NOTICE_MODE=off
KIOSK_PRIVACY_NOTICE_AR="تُستخدم الكاميرا لتجربة الملابس، وتُحذف الصور تلقائيًا خلال 24 ساعة"
KIOSK_PRIVACY_NOTICE_EN="Camera images are used for virtual try-on and deleted automatically within 24 hours."

AI_TRYON_PROVIDER=mock
AI_TRYON_RETENTION_HOURS=24
AI_TRYON_TIMEOUT_SECONDS=90
NVIDIA_API_KEY=
NVIDIA_TRYON_ENDPOINT=
NVIDIA_HEALTH_ENDPOINT=
NVIDIA_TRYON_MODEL=flux.2-klein-4b
NVIDIA_TRYON_PROMPT=

RUNPOD_ENABLED=false
RUNPOD_API_BASE=https://rest.runpod.io/v1
RUNPOD_API_KEY=
RUNPOD_POD_ID=
RUNPOD_TIMEZONE=Africa/Cairo
RUNPOD_ACTIVE_START=09:30
RUNPOD_ACTIVE_END=22:15
LOCAL_VTON_BASE_URL=http://127.0.0.1:8788
LOCAL_VTON_MODEL=idm-vton

LIVE_RESTYLE_ENABLED=false
LIVE_RESTYLE_PROVIDER=fal
LIVE_RESTYLE_MODEL=decart/lucy2-vton/realtime
LIVE_RESTYLE_MAX_SECONDS=20
LIVE_RESTYLE_DAILY_SECONDS_LIMIT=120
LIVE_RESTYLE_PRICE_PER_SECOND_USD=0.02
LIVE_RESTYLE_LOCAL_PROXY_URL=http://127.0.0.1:8787

SEED_DEMO_DATA=true
ADMIN_NAME="Store Admin"
ADMIN_EMAIL=admin@smartmirror.test
ADMIN_PASSWORD=ChangeMe123!
DEMO_TENANT_NAME="Demo Fashion Store"
DEMO_TENANT_DOMAIN=demo.smartmirror.local
