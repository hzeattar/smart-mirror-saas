{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm install --include=dev --no-audit --no-fund && npm run build && test -f public/build/manifest.json"
  },
  "deploy": {
    "startCommand": "bash start-container.sh",
    "healthcheckPath": "/up",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
